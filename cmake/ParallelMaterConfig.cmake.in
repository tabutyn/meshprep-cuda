# SPDX-License-Identifier: MIT
@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/ParallelMaterTargets.cmake")
if(NOT CMAKE_CUDA_TOOLKIT_INCLUDE_DIRECTORIES)
    message(FATAL_ERROR
        "ParallelMater consumers must enable CUDA before find_package(ParallelMater)")
endif()
set_property(TARGET ParallelMater::geometry APPEND PROPERTY
    INTERFACE_COMPILE_OPTIONS
    "$<$<COMPILE_LANGUAGE:CXX>:-I${CMAKE_CUDA_TOOLKIT_INCLUDE_DIRECTORIES}>")
check_required_components(ParallelMater)
